# Copy this file to `.env` and adjust the values. `.env` is git-ignored: never commit it.
# Docker Compose reads `.env` automatically. The backend reads the same variable names
# from the process environment and falls back to the local defaults shown here.

# --- PostgreSQL ---
POSTGRES_DB=applypilot
POSTGRES_USER=applypilot
POSTGRES_PASSWORD=applypilot
POSTGRES_PORT=5432

# --- Backend ---
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/applypilot
DB_USERNAME=applypilot
DB_PASSWORD=applypilot
# HMAC secret used to sign JWTs. Must be at least 32 characters. Use a long random value outside local dev.
JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Folder where uploaded CVs are stored (git-ignored). Relative to the backend working directory.
STORAGE_DIR=./storage

# --- AI (job posting analysis) ---
# Groq API key (https://console.groq.com/keys). Empty = AI features use the keyword fallback.
GROQ_API_KEY=
# Optional overrides (uncomment to use). An empty value would override the default, so
# leave unused ones commented. The defaults target Groq.
# AI_API_KEY takes precedence over GROQ_API_KEY.
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# AI_TIMEOUT=30s
# low, medium or high for reasoning models; empty for providers that reject the parameter.
# AI_REASONING_EFFORT=low
# AI calls each user may make per day, shared by all AI features and agents.
# AI_DAILY_LIMIT=30

# Access (optional). Production defaults: registration off, demo on.
# APP_REGISTRATION_ENABLED=true
# APP_DEMO_ENABLED=false
# Recreates the demo account at the next start; remove it afterwards.
# APP_DEMO_RESET_ON_START=false
