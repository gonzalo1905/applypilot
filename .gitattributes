# Normalize line endings so Windows and Unix checkouts produce identical commits
* text=auto

# Shell scripts must keep LF (they run inside Linux containers and on macOS/Linux)
*.sh text eol=lf
mvnw text eol=lf

# Windows scripts must keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.pdf binary
